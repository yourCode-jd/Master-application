generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessType {
  SALON
  CAFE
  RETAIL
  GYM
  OTHER
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  OFF_DUTY
  ON_LEAVE
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum TransactionType {
  PAYMENT_IN
  PAYMENT_OUT
  EXPENSE
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ARRIVED
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  WALK_IN
  PHONE
  WHATSAPP
  MANUAL
  OTHER
}

enum WalkInStatus {
  WAITING
  ASSIGNED
  IN_SERVICE
  COMPLETED
  LEFT
}

enum VisitStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum ReturnStatus {
  UPCOMING
  DUE
  CONTACTED
  BOOKED
  RETURNED
  DISMISSED
}

enum TransactionMethod {
  CASH
  UPI
  CARD
  BANK
  OTHER
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum CommissionAdjustmentType {
  BONUS
  CORRECTION
  DEDUCTION
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PackageStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum StockMovementType {
  OPENING
  ADJUSTMENT
  RECEIPT
  ISSUE
  DAMAGED
  RETURNED
}

model Business {
  id                           String                        @id @default(cuid())
  name                         String
  slug                         String                        @unique
  type                         BusinessType                  @default(OTHER)
  timezone                     String                        @default("Asia/Kolkata")
  currency                     String                        @default("INR")
  workingHours                 Json?
  status                       BusinessStatus                @default(ACTIVE)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  locations                    BusinessLocation[]
  staff                        StaffMember[]
  memberships                  UserBusinessRole[]
  customers                    Customer[]
  activities                   Activity[]
  tasks                        Task[]
  items                        Item[]
  categories                   ItemCategory[]
  inventoryLocations           InventoryLocation[]
  suppliers                    Supplier[]
  stockMovements               StockMovement[]
  auditLogs                    AuditLog[]
  notes                        CustomerNote[]
  purchases                    Purchase[]
  transactions                 TransactionRecord[]
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  serviceCategories            ServiceCategory[]
  services                     Service[]
  appointments                 Appointment[]
  visits                       Visit[]
  walkIns                      WalkIn[]
  returnRecommendations        ReturnRecommendation[]
  followUpTemplates            FollowUpTemplate[]
  commissionRules              CommissionRule[]
  commissionAdjustments        CommissionAdjustment[]
  commissionSettlements        CommissionSettlement[]
  discountPolicy               DiscountPolicy?
  serviceInventoryRequirements ServiceInventoryRequirement[]
  serviceInventoryUsages       VisitServiceInventoryUsage[]
  membershipPlans              MembershipPlan[]
  customerMemberships          CustomerMembership[]
  servicePackages              ServicePackage[]
  customerPackages             CustomerPackage[]
  packageUsages                PackageUsage[]
}

model BusinessLocation {
  id           String        @id @default(cuid())
  businessId   String
  name         String
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  phone        String?
  workingHours Json?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  visits       Visit[]
  walkIns      WalkIn[]

  @@index([businessId])
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  passwordHash            String
  active                  Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             UserBusinessRole[]
  staffProfiles           StaffMember[]
  audits                  AuditLog[]
  movements               StockMovement[]
  taskAssignments         Task[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  customerMemberships     CustomerMembership[]
  customerPackages        CustomerPackage[]
  commissionAdjustments   CommissionAdjustment[]   @relation("CommissionAdjustmentCreator")
  commissionSettlements   CommissionSettlement[]   @relation("CommissionSettlementCreator")
  correctedPayments       TransactionRecord[]      @relation("PaymentCorrectedBy")
}

model StaffMember {
  id                      String                 @id @default(cuid())
  businessId              String
  userId                  String?
  name                    String
  phone                   String
  email                   String?
  status                  StaffStatus            @default(ACTIVE)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  business                Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                    User?                  @relation(fields: [userId], references: [id])
  activities              Activity[]
  tasks                   Task[]
  notes                   CustomerNote[]
  availability            AvailabilityStatus     @default(AVAILABLE)
  staffServices           StaffService[]
  appointments            Appointment[]
  appointmentServices     AppointmentService[]
  visits                  Visit[]
  visitServices           VisitService[]
  preferredWalkIns        WalkIn[]               @relation("WalkInPreferred")
  assignedWalkIns         WalkIn[]               @relation("WalkInAssigned")
  assignedRecommendations ReturnRecommendation[]
  commissionRules         CommissionRule[]
  commissionAdjustments   CommissionAdjustment[]
  commissionSettlements   CommissionSettlement[]

  @@index([businessId])
  @@index([userId])
}

model Role {
  id          String             @id @default(cuid())
  key         String             @unique
  name        String
  permissions RolePermission[]
  assignments UserBusinessRole[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserBusinessRole {
  userId     String
  businessId String
  roleId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, businessId, roleId])
  @@index([businessId, userId])
}

model Customer {
  id                    String                 @id @default(cuid())
  businessId            String
  name                  String
  phone                 String
  email                 String?
  notes                 String?
  status                CustomerStatus         @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  activities            Activity[]
  tasks                 Task[]
  customerNotes         CustomerNote[]
  appointments          Appointment[]
  visits                Visit[]
  returnRecommendations ReturnRecommendation[]
  walkIns               WalkIn[]
  memberships           CustomerMembership[]
  packages              CustomerPackage[]

  @@index([businessId, name])
  @@index([businessId, phone])
}

model Activity {
  id          String       @id @default(cuid())
  businessId  String
  customerId  String?
  staffId     String?
  type        String
  title       String
  description String?
  metadata    Json?
  occurredAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staff       StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([businessId, occurredAt])
}

model Task {
  id                     String                @id @default(cuid())
  businessId             String
  customerId             String?
  assignedStaffId        String?
  assignedUserId         String?
  returnRecommendationId String?
  title                  String
  description            String?
  type                   String                @default("GENERAL")
  priority               TaskPriority          @default(NORMAL)
  source                 String                @default("MANUAL")
  status                 TaskStatus            @default(OPEN)
  dueAt                  DateTime?
  completedAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  business               Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer               Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedStaff          StaffMember?          @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedUser           User?                 @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  returnRecommendation   ReturnRecommendation? @relation(fields: [returnRecommendationId], references: [id], onDelete: SetNull)

  @@index([businessId, status, dueAt])
}

model ItemCategory {
  id         String   @id @default(cuid())
  businessId String
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items      Item[]

  @@unique([businessId, name])
}

model InventoryLocation {
  id         String          @id @default(cuid())
  businessId String
  name       String
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  movements  StockMovement[]

  @@unique([businessId, name])
}

model Item {
  id                  String                        @id @default(cuid())
  businessId          String
  categoryId          String?
  name                String
  sku                 String?
  barcode             String?
  unit                String                        @default("unit")
  active              Boolean                       @default(true)
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  business            Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category            ItemCategory?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  movements           StockMovement[]
  supplierItems       SupplierItem[]
  purchasedItems      PurchaseItem[]
  preferredSupplierId String?
  reorderLevel        Decimal                       @default(0) @db.Decimal(12, 3)
  purchaseCost        Decimal?                      @db.Decimal(14, 2)
  retailPrice         Decimal?                      @db.Decimal(14, 2)
  preferredSupplier   Supplier?                     @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  serviceRequirements ServiceInventoryRequirement[]
  serviceUsages       VisitServiceInventoryUsage[]

  @@unique([businessId, sku])
  @@index([businessId, name])
}

model Supplier {
  id               String         @id @default(cuid())
  businessId       String
  name             String
  phone            String
  email            String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  active           Boolean        @default(true)
  items            SupplierItem[]
  preferredByItems Item[]         @relation("PreferredSupplier")
  purchases        Purchase[]

  @@unique([businessId, name])
  @@index([businessId, name])
}

model StockMovement {
  id                  String                      @id @default(cuid())
  businessId          String
  itemId              String
  locationId          String
  quantityChange      Decimal                     @db.Decimal(12, 3)
  type                StockMovementType
  reason              String?
  staffId             String?
  userId              String?
  purchaseId          String?
  visitServiceUsageId String?                     @unique
  occurredAt          DateTime                    @default(now())
  createdAt           DateTime                    @default(now())
  business            Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  item                Item                        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location            InventoryLocation           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  user                User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  purchase            Purchase?                   @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  visitServiceUsage   VisitServiceInventoryUsage? @relation(fields: [visitServiceUsageId], references: [id], onDelete: SetNull)

  @@index([businessId, itemId, occurredAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  businessId  String
  actorUserId String
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
}

model CustomerNote {
  id            String       @id @default(cuid())
  businessId    String
  customerId    String
  authorStaffId String?
  authorUserId  String?
  note          String
  createdAt     DateTime     @default(now())
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorStaff   StaffMember? @relation(fields: [authorStaffId], references: [id], onDelete: SetNull)

  @@index([businessId, customerId, createdAt])
}

model SupplierItem {
  supplierId String
  itemId     String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([supplierId, itemId])
}

model Purchase {
  id              String          @id @default(cuid())
  businessId      String
  supplierId      String
  referenceNumber String?
  purchaseDate    DateTime        @default(now())
  status          PurchaseStatus  @default(DRAFT)
  notes           String?
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items           PurchaseItem[]
  movements       StockMovement[]

  @@index([businessId, status, purchaseDate])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  itemId     String
  quantity   Decimal  @db.Decimal(12, 3)
  unitCost   Decimal  @db.Decimal(14, 2)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
}

model TransactionRecord {
  id                String              @id @default(cuid())
  businessId        String
  type              TransactionType
  amount            Decimal             @db.Decimal(14, 2)
  method            TransactionMethod
  reference         String?
  customerId        String?
  supplierId        String?
  notes             String?
  occurredAt        DateTime            @default(now())
  createdBy         String
  correctedAt       DateTime?
  correctedById     String?
  correctionReason  String?
  createdAt         DateTime            @default(now())
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  correctedBy       User?               @relation("PaymentCorrectedBy", fields: [correctedById], references: [id], onDelete: SetNull)
  membershipPayment CustomerMembership? @relation("MembershipPayment")
  packagePayment    CustomerPackage?    @relation("PackagePayment")

  @@index([businessId, occurredAt])
}

model Notification {
  id         String    @id @default(cuid())
  businessId String
  userId     String
  type       String
  title      String
  message    String
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, userId, readAt, createdAt])
}

model NotificationPreference {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  type       String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, type])
  @@index([businessId, userId])
}

model WorkerHeartbeat {
  name        String   @id
  lastStarted DateTime
  lastSuccess DateTime?
  lastError   String?
  updatedAt   DateTime @updatedAt
}

model AuthRateLimit {
  key           String   @id
  attempts      Int      @default(0)
  windowStarted DateTime
  blockedUntil  DateTime?
  updatedAt     DateTime @updatedAt
}

model MembershipPlan {
  id           String               @id @default(cuid())
  businessId   String
  name         String
  description  String?
  price        Decimal              @db.Decimal(14, 2)
  validityDays Int
  benefits     Json?
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships  CustomerMembership[]

  @@unique([businessId, name])
  @@index([businessId, active])
}

model CustomerMembership {
  id                  String             @id @default(cuid())
  businessId          String
  customerId          String
  membershipPlanId    String
  planNameSnapshot    String
  descriptionSnapshot String?
  benefitsSnapshot    Json?
  priceSnapshot       Decimal            @db.Decimal(14, 2)
  startDate           DateTime
  endDate             DateTime
  status              MembershipStatus   @default(ACTIVE)
  purchasedAt         DateTime           @default(now())
  paymentId           String?            @unique
  createdBy           String
  cancelledAt         DateTime?
  cancellationReason  String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  business            Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer            Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan                MembershipPlan     @relation(fields: [membershipPlanId], references: [id], onDelete: Restrict)
  payment             TransactionRecord? @relation("MembershipPayment", fields: [paymentId], references: [id], onDelete: SetNull)
  user                User?              @relation(fields: [userId], references: [id])
  userId              String?

  @@index([businessId, customerId, status, endDate])
}

model ServicePackage {
  id           String               @id @default(cuid())
  businessId   String
  name         String
  description  String?
  price        Decimal              @db.Decimal(14, 2)
  validityDays Int?
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items        ServicePackageItem[]
  purchases    CustomerPackage[]

  @@unique([businessId, name])
  @@index([businessId, active])
}

model ServicePackageItem {
  packageId        String
  serviceId        String
  includedQuantity Int
  package          ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service          Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([packageId, serviceId])
}

model CustomerPackage {
  id                  String                @id @default(cuid())
  businessId          String
  customerId          String
  servicePackageId    String
  packageNameSnapshot String
  descriptionSnapshot String?
  priceSnapshot       Decimal               @db.Decimal(14, 2)
  startDate           DateTime
  expiryDate          DateTime?
  status              PackageStatus         @default(ACTIVE)
  purchasedAt         DateTime              @default(now())
  paymentId           String?               @unique
  createdBy           String
  cancelledAt         DateTime?
  cancellationReason  String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  business            Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer            Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  servicePackage      ServicePackage        @relation(fields: [servicePackageId], references: [id], onDelete: Restrict)
  payment             TransactionRecord?    @relation("PackagePayment", fields: [paymentId], references: [id], onDelete: SetNull)
  items               CustomerPackageItem[]
  usages              PackageUsage[]
  user                User?                 @relation(fields: [userId], references: [id])
  userId              String?

  @@index([businessId, customerId, status, expiryDate])
}

model CustomerPackageItem {
  id                  String          @id @default(cuid())
  customerPackageId   String
  serviceId           String
  serviceNameSnapshot String
  includedQuantity    Int
  usedQuantity        Int             @default(0)
  customerPackage     CustomerPackage @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  service             Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  usages              PackageUsage[]

  @@unique([customerPackageId, serviceId])
}

model PackageUsage {
  id                    String              @id @default(cuid())
  businessId            String
  customerPackageId     String
  customerPackageItemId String
  visitServiceId        String              @unique
  quantity              Int                 @default(1)
  usedAt                DateTime            @default(now())
  createdBy             String
  business              Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerPackage       CustomerPackage     @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  customerPackageItem   CustomerPackageItem @relation(fields: [customerPackageItemId], references: [id], onDelete: Cascade)
  visitService          VisitService        @relation(fields: [visitServiceId], references: [id], onDelete: Cascade)

  @@index([businessId, customerPackageId])
}

model ServiceCategory {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  description String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services    Service[]

  @@unique([businessId, name])
}

model Service {
  id                    String                        @id @default(cuid())
  businessId            String
  categoryId            String?
  name                  String
  description           String?
  durationMinutes       Int
  price                 Decimal                       @db.Decimal(14, 2)
  active                Boolean                       @default(true)
  recommendedReturnDays Int?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  business              Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category              ServiceCategory?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  staffServices         StaffService[]
  appointmentServices   AppointmentService[]
  visitServices         VisitService[]
  recommendations       ReturnRecommendation[]
  walkIns               WalkIn[]
  commissionRules       CommissionRule[]
  inventoryRequirements ServiceInventoryRequirement[]
  servicePackageItems   ServicePackageItem[]
  customerPackageItems  CustomerPackageItem[]

  @@index([businessId, name])
}

model StaffService {
  businessId String
  staffId    String
  serviceId  String
  active     Boolean     @default(true)
  staff      StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service    Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([businessId])
}

model Appointment {
  id                    String                 @id @default(cuid())
  businessId            String
  customerId            String
  staffId               String?
  locationId            String
  startAt               DateTime
  endAt                 DateTime
  status                AppointmentStatus      @default(PENDING)
  source                AppointmentSource      @default(MANUAL)
  notes                 String?
  createdBy             String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staff                 StaffMember?           @relation(fields: [staffId], references: [id], onDelete: SetNull)
  location              BusinessLocation       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  services              AppointmentService[]
  visits                Visit[]
  returnRecommendations ReturnRecommendation[]

  @@index([businessId, staffId, startAt, endAt])
}

model AppointmentService {
  id               String       @id @default(cuid())
  appointmentId    String
  serviceId        String
  staffId          String?
  priceSnapshot    Decimal      @db.Decimal(14, 2)
  durationSnapshot Int
  appointment      Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service          Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff            StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)
}

model Visit {
  id              String                 @id @default(cuid())
  businessId      String
  customerId      String
  locationId      String
  appointmentId   String?
  primaryStaffId  String?
  source          AppointmentSource      @default(OTHER)
  startedAt       DateTime               @default(now())
  completedAt     DateTime?
  status          VisitStatus            @default(OPEN)
  notes           String?
  totalAmount     Decimal                @default(0) @db.Decimal(14, 2)
  createdAt       DateTime               @default(now())
  business        Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  location        BusinessLocation       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  appointment     Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  primaryStaff    StaffMember?           @relation(fields: [primaryStaffId], references: [id], onDelete: SetNull)
  services        VisitService[]
  recommendations ReturnRecommendation[]

  @@index([businessId, customerId, completedAt])
}

model VisitService {
  id                        String                       @id @default(cuid())
  visitId                   String
  serviceId                 String
  staffId                   String?
  priceSnapshot             Decimal                      @db.Decimal(14, 2)
  durationSnapshot          Int?
  discountType              DiscountType?
  discountValue             Decimal?                     @db.Decimal(14, 2)
  discountAmount            Decimal                      @default(0) @db.Decimal(14, 2)
  discountSource            String?
  membershipDiscountAmount  Decimal                      @default(0) @db.Decimal(14, 2)
  membershipBenefitSnapshot Json?
  finalAmount               Decimal                      @default(0) @db.Decimal(14, 2)
  commissionType            CommissionType?
  commissionValue           Decimal?                     @db.Decimal(14, 2)
  commissionAmount          Decimal                      @default(0) @db.Decimal(14, 2)
  commissionRuleId          String?
  visit                     Visit                        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  service                   Service                      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff                     StaffMember?                 @relation(fields: [staffId], references: [id], onDelete: SetNull)
  inventoryUsages           VisitServiceInventoryUsage[]
  packageUsage              PackageUsage?
}

model ServiceInventoryRequirement {
  id                 String   @id @default(cuid())
  businessId         String
  serviceId          String
  itemId             String
  quantityPerService Decimal  @db.Decimal(14, 3)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service            Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  item               Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([serviceId, itemId])
  @@index([businessId, serviceId])
}

model VisitServiceInventoryUsage {
  id             String         @id @default(cuid())
  businessId     String
  visitServiceId String
  itemId         String
  quantity       Decimal        @db.Decimal(14, 3)
  unitSnapshot   String
  requirementId  String?
  createdAt      DateTime       @default(now())
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  visitService   VisitService   @relation(fields: [visitServiceId], references: [id], onDelete: Cascade)
  item           Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  movement       StockMovement?

  @@unique([visitServiceId, itemId])
  @@index([businessId, itemId])
}

model CommissionRule {
  id            String         @id @default(cuid())
  businessId    String
  staffId       String
  serviceId     String?
  type          CommissionType
  value         Decimal        @db.Decimal(14, 2)
  active        Boolean        @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff         StaffMember    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([businessId, staffId, serviceId, active])
}

model CommissionAdjustment {
  id         String                   @id @default(cuid())
  businessId String
  staffId    String
  amount     Decimal                  @db.Decimal(14, 2)
  type       CommissionAdjustmentType
  reason     String
  date       DateTime                 @default(now())
  createdBy  String
  createdAt  DateTime                 @default(now())
  business   Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff      StaffMember              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  creator    User                     @relation("CommissionAdjustmentCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([businessId, staffId, date])
}

model CommissionSettlement {
  id               String      @id @default(cuid())
  businessId       String
  staffId          String
  periodStart      DateTime
  periodEnd        DateTime
  amount           Decimal     @db.Decimal(14, 2)
  grossCommission  Decimal     @default(0) @db.Decimal(14, 2)
  adjustmentAmount Decimal     @default(0) @db.Decimal(14, 2)
  settledAt        DateTime    @default(now())
  settledBy        String
  createdAt        DateTime    @default(now())
  business         Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff            StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  settler          User        @relation("CommissionSettlementCreator", fields: [settledBy], references: [id], onDelete: Restrict)

  @@unique([businessId, staffId, periodStart, periodEnd])
  @@index([businessId, staffId, periodEnd])
}

model DiscountPolicy {
  id                   String   @id @default(cuid())
  businessId           String   @unique
  staffMaxPercentage   Decimal  @default(5) @db.Decimal(5, 2)
  managerMaxPercentage Decimal  @default(15) @db.Decimal(5, 2)
  staffMaxFixed        Decimal  @default(0) @db.Decimal(14, 2)
  managerMaxFixed      Decimal  @default(0) @db.Decimal(14, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model ReturnRecommendation {
  id              String       @id @default(cuid())
  businessId      String
  customerId      String
  visitId         String
  serviceId       String
  staffId         String?
  appointmentId   String?
  recommendedDate DateTime
  status          ReturnStatus @default(UPCOMING)
  contactedAt     DateTime?
  returnedAt      DateTime?
  dismissedAt     DateTime?
  assignedAt      DateTime?
  contactNote     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  visit           Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  service         Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff           StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  tasks           Task[]

  @@unique([visitId, serviceId])
  @@index([businessId, status, recommendedDate])
  @@index([businessId, staffId, status])
}

model FollowUpTemplate {
  id         String   @id @default(cuid())
  businessId String
  name       String
  body       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
}

model WalkIn {
  id               String           @id @default(cuid())
  businessId       String
  customerId       String
  serviceId        String
  preferredStaffId String?
  assignedStaffId  String?
  locationId       String
  status           WalkInStatus     @default(WAITING)
  notes            String?
  createdAt        DateTime         @default(now())
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service          Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  preferredStaff   StaffMember?     @relation("WalkInPreferred", fields: [preferredStaffId], references: [id], onDelete: SetNull)
  assignedStaff    StaffMember?     @relation("WalkInAssigned", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  location         BusinessLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([businessId, status, createdAt])
}
